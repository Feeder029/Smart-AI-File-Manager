        "jsCode": "const category = $json.text?.trim();\n\nconst folders = {\n  Career: 'Career',\n  Finance: 'Finance',\n  School: 'School',\n  Projects: 'Projects',\n  Personal: 'Personal',\n  Documents: 'Documents',\n  Media: 'Media',\n  Other: 'Other'\n};\n\nconst folder = folders[category] || 'Other';\n\nreturn [\n  {\n    json: {\n      category,\n      destination: `C:\\\\SmartFileOrganizer\\\\Organized\\\\${folder}`\n    }\n  }\n];"
      },
