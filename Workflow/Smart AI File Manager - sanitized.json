    {
      "parameters": {
        "jsCode": "const ext = ($json.fileExtension || '').toLowerCase();\n\nconst groups = {\n  document: [\n    'pdf', 'txt', 'html', 'csv', 'json',\n    'xml', 'xls', 'xlsx', 'ods', 'rtf', 'ics'\n  ],\n\n  image: [\n    'jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp', 'svg'\n  ],\n\n  code: [\n    'py', 'js', 'ts', 'dart', 'java',\n    'php', 'c', 'cpp', 'cs', 'css'\n  ],\n\n  audio: [\n    'mp3', 'wav', 'flac', 'm4a', 'ogg'\n  ],\n\n  video: [\n    'mp4', 'mkv', 'avi', 'mov', 'webm'\n  ],\n\n  archive: [\n    'zip', 'rar', '7z', 'tar', 'gz'\n  ],\n\n  application: [\n    'apk', 'exe', 'msi', 'appx'\n  ]\n};\n\nlet fileType = 'other';\n\nfor (const [type, extensions] of Object.entries(groups)) {\n  if (extensions.includes(ext)) {\n    fileType = type;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    ...$json,\n    fileType\n  },\n  binary: $binary\n}];"
      },
